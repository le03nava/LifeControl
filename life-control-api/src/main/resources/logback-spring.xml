<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/base.xml"/>
    <springProperty scope="context" name="appName" source="spring.application.name"/>
    <springProperty scope="context" name="lokiUrl" source="loki.url"/>

    <!-- Console appender for debugging -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSSZ} %-5level [%thread] [%X{traceId:-},%X{spanId:-}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>${lokiUrl}</url>
        </http>
        <format>
            <label>
                <pattern>application=${appName},host=${HOSTNAME},level=%level</pattern>
            </label>
            <message>
                <pattern>${FILE_LOG_PATTERN}</pattern>
            </message>
        </format>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOKI"/>
    </root>

    <!-- Logbook HTTP request/response logging. Logbook's default writer emits its
         messages through exactly this logger, so pinning it is what makes Logbook log at
         all; *what* it emits is the strategy in LogbookConfig — every exchange on dev,
         only a status >= 400 everywhere else. A logger for the whole `org.zalando.logbook`
         package is not equivalent: Spring Boot's condition-evaluation lines about the
         Logbook auto-configuration classes are emitted under those condition classes' own
         names (`org.zalando.logbook.ecs.autoconfigure.*`), so the package-level logger
         turns them on too — measured: 2 of them on the boot with the package pinned versus
         0 with this line. `LogbookLogbookLoggerPinningTest` fails if this is weakened. -->
    <logger name="org.zalando.logbook.Logbook" level="TRACE"/>

    <!-- Debug logging for SQL — development profile only (avoids leaking
         query parameter data in staging/prod logs) -->
    <springProfile name="dev">
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="TRACE"/>
        <logger name="org.hibernate.orm.jdbc.bind" level="TRACE"/>
        <logger name="com.lifecontrol.api" level="DEBUG"/>
    </springProfile>
</configuration>
