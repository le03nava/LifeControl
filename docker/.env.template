# ============================================
# LifeControl - Environment Variables Template
# ============================================
# FLUJO CANONICO: usar ./docker/scripts/setup-env.sh [dev|staging|prod]
# El script copia este template al .env.<env> correspondiente.
# Los valores aqui listados son los defaults de DESARROLLO.
# ============================================

# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================
COMPOSE_PROJECT_NAME=lifecontrol
ENVIRONMENT=development
SPRING_PROFILES_ACTIVE=dev

# ============================================
# PORTS - Development Base Ports
# ============================================
POSTGRES_PORT=5433
KEYCLOAK_PORT=8181
API_GATEWAY_PORT=9000
LOKI_PORT=3100
PROMETHEUS_PORT=9090
TEMPO_PORT=3110
TEMPO_ZIPKIN_PORT=9411
GRAFANA_PORT=3000
REDIS_PORT=6379

# ============================================
# DATABASE CREDENTIALS - DEVELOPMENT
# ============================================
KEYCLOAK_POSTGRES_DB=keycloak
KEYCLOAK_POSTGRES_USER=keycloak

# PostgreSQL - LifeControl API Database
LIFECONTROL_POSTGRES_DB=lifecontrol
LIFECONTROL_POSTGRES_USER=lifecontrol_user
LIFECONTROL_POSTGRES_PORT=5435

# ============================================
# LIFECONTROL API CONFIGURATION
# ============================================
LIFECONTROL_API_PORT=8082
LIFECONTROL_DATABASE_URL=jdbc:postgresql://lifecontrol-postgres:5432/lifecontrol
LIFECONTROL_DATABASE_USERNAME=lifecontrol_user

# ============================================
# WEB APP CONFIGURATION
# ============================================
WEB_APP_IMAGE=life-control-app-angular:latest
WEB_APP_PORT=4200
# URL pública de la app. Default: http://localhost:${WEB_APP_PORT}. Se usa para el
# redirect Uri y web origins del client public en keycloak-setup.sh.
# WEB_APP_URL=http://localhost:4200
KEYCLOAK_URL=http://localhost:8181
KEYCLOAK_REALM=life-control-realm
KEYCLOAK_CLIENT_ID=life-control-client
API_GATEWAY_URL=http://localhost:9000
API_BASE_PATH=/api

# ============================================
# KEYCLOAK CONFIGURATION
# ============================================
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://keycloak-postgres/keycloak
KC_DB_USERNAME=keycloak
KC_HOSTNAME=localhost
KC_HTTP_PORT=8080
KC_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_SERVER_URL=http://keycloak:8080
KEYCLOAK_ADMIN_CLIENT_ID=life-control-admin-client

# ============================================
# DOCKER IMAGES - Versions
# ============================================
POSTGRES_IMAGE=postgres:18.1

KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.2.1
LOKI_IMAGE=grafana/loki:2.9.0
PROMETHEUS_IMAGE=prom/prometheus:v2.48.0
GRAFANA_IMAGE=grafana/grafana:10.2.0
TEMPO_IMAGE=grafana/tempo:2.3.0

# ============================================
# API GATEWAY CONFIGURATION
# ============================================
API_GATEWAY_SERVER_PORT=9000
API_GATEWAY_MANAGEMENT_PORT=9001
KEYCLOAK_ISSUER_URI=http://localhost:8181/realms/life-control-realm

# Circuit Breaker
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=30
CIRCUIT_BREAKER_WINDOW_SIZE=5
TIMEOUT_DURATION=2s
RETRY_MAX_ATTEMPTS=2

# Logging
LOG_LEVEL=DEBUG
TRACING_ENABLED=true
TRACING_SAMPLING_PROBABILITY=0.5

# ============================================
# MONITORING CONFIGURATION
# ============================================
PROMETHEUS_ENABLED=true
LOKI_URL=http://loki:3100/loki/api/v1/push

# Health Checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=15s
HEALTH_CHECK_TIMEOUT=2s
HEALTH_CHECK_START_PERIOD=30s
HEALTH_CHECK_RETRIES=2

# ============================================
# GRAFANA CONFIGURATION
# ============================================
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Admin
GF_AUTH_DISABLE_LOGIN_FORM=true

# ============================================
# VOLUMES - Root directory for all service data
# ============================================
VOLUMES_ROOT=./volumes-dev

# ============================================
# RESOURCE LIMITS - Development
# ============================================
POSTGRES_MEMORY_LIMIT=512m
LIFECONTROL_POSTGRES_MEMORY_LIMIT=256m
KEYCLOAK_MEMORY_LIMIT=1g
API_GATEWAY_MEMORY_LIMIT=512m
LIFECONTROL_API_MEMORY_LIMIT=512m
PROMETHEUS_MEMORY_LIMIT=512m
GRAFANA_MEMORY_LIMIT=256m
TEMPO_MEMORY_LIMIT=512m
LOKI_MEMORY_LIMIT=256m
